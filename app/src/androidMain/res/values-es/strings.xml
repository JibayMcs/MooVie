<?xml version="1.0" encoding="utf-8"?>
<!--
  Traducciones de los recursos Android **históricos** — ver `values/strings.xml`.

  Solo queda aquí el selector de idioma, único superviviente de ese sistema: el
  resto de la app lee sus textos en `commonMain/composeResources`. `app_name` no
  está: no se traduce.

  Estos archivos deben mantenerse **alineados con la configuración regional por
  defecto**. Una cadena traducida aquí sin equivalente allí es un error *fatal*
  de lint (`ExtraTranslation`): no rompe la compilación de depuración, solo
  `assembleRelease` — es decir, la CI de publicación, y únicamente ella.
-->
<resources>
    <string name="settings_language">Idioma de la aplicación</string>
    <string name="language_system">Idioma del sistema</string>
    <string name="language_fr">Francés</string>
    <string name="language_en">Inglés</string>
    <string name="language_es">Español</string>
</resources>
