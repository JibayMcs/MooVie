<?xml version="1.0" encoding="utf-8"?>
<!--
  Traductions des ressources Android **historiques** — voir `values/strings.xml`.

  Ne subsiste ici que le sélecteur de langue, seul rescapé de ce système : tout
  le reste de l'app lit ses textes dans `commonMain/composeResources`. `app_name`
  n'y est pas, il ne se traduit pas.

  Ces fichiers doivent rester **alignés sur la locale par défaut**. Une chaîne
  traduite ici sans équivalent là-bas est une erreur *fatale* de lint
  (`ExtraTranslation`) : elle ne casse pas le build de debug, seulement
  `assembleRelease` — donc la CI de publication, et elle seule.
-->
<resources>
    <string name="settings_language">App language</string>
    <string name="language_system">System language</string>
    <string name="language_fr">French</string>
    <string name="language_en">English</string>
    <string name="language_es">Spanish</string>
</resources>
