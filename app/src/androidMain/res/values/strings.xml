<?xml version="1.0" encoding="utf-8"?>
<!--
  Ressources Android **historiques**. Tout le reste de l'app lit ses textes dans
  `commonMain/composeResources`, partagé avec le desktop.

  Il n'en subsiste que ce qui ne peut pas venir d'ailleurs :

  - `app_name`, exigé par le manifeste (`android:label`), qui n'a pas accès aux
    ressources Compose ;
  - le sélecteur de langue, qui s'appuie sur `AppCompatDelegate` et vit donc
    forcément côté Android.

  **Ne rien ajouter ici.** Ce fichier contenait ~90 chaînes dont 6 seulement
  étaient encore lues ; les autres doublonnaient les ressources Compose et
  avaient silencieusement divergé. Un message d'erreur modifié dans
  `composeResources` restait alors sans effet à l'écran, parce que le code
  Android lisait le doublon d'ici.
-->
<resources>
    <string name="app_name">Moo-vie</string>

    <!-- Sélecteur de langue de l'application (AppCompatDelegate, Android seul) -->
    <string name="settings_language">Langue de l\'application</string>
    <string name="language_system">Langue du système</string>
    <string name="language_fr">Français</string>
    <string name="language_en">Anglais</string>
    <string name="language_es">Espagnol</string>
</resources>
