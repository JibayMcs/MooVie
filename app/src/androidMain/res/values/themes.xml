<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème hôte pour l'Activity : le rendu réel est en Compose (MooVieTheme). -->
    <style name="Theme.MooVie" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!--
      Splash système réduit à un aplat : l'animation de lancement est rendue par
      l'app (MoovieSplash), pas ici. Android 12+ masque `windowSplashScreenAnimatedIcon`
      dans un cercle dont seul le centre est visible — c'est ce qui rognait le logo.
      Le masque n'étant pas désactivable, on passe une icône transparente : reste
      un fond uni, exactement de la couleur de la 1re image de l'animation.
    -->
    <style name="Theme.MooVie.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="postSplashScreenTheme">@style/Theme.MooVie</item>
    </style>
</resources>
