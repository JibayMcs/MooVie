<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lecture : garde le CPU/Wi-Fi éveillés (setWakeMode) pendant le streaming -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Retour haptique de la télécommande virtuelle. Permission de niveau
         normal : accordée à l'installation, rien à demander à l'exécution. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Téléchargement hors ligne : le service de premier plan est ce qui
         empêche Android de tuer la file au premier passage en arrière-plan.
         POST_NOTIFICATIONS est demandée à l'exécution sur Android 13+ ; sans
         elle le service tourne quand même, seule la barre reste invisible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Diffusion vers la TV : le service qui suit la box et met ses commandes
         dans le volet. Le type est bien `mediaPlayback` — celui d'une lecture
         déportée sur un autre appareil, le cas du Cast — et non `dataSync`
         ci-dessus, dont Android 15 borne l'usage à un quota journalier qu'une
         soirée de série dépasserait. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Auto-updater : installation des APK de mise à jour téléchargés -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Sauvegarde : écrire à la racine d'une clé USB ou du stockage interne.

      Sans elle, l'app n'écrit que dans son propre dossier — que la
      désinstallation efface avec le reste. « Je réinstalle et je restaure »
      était donc impossible, ce qui vide la sauvegarde de son objet premier.
      La migration d'un appareil à l'autre, elle, marchait déjà.

      Elle n'est **pas** demandée au lancement : elle ne sert qu'à la
      sauvegarde, et l'écran de sauvegarde l'explique avant de l'ouvrir.
      Refusée, tout continue de fonctionner dans le dossier de l'app.

      Play Store restreint fortement cette permission ; Moo-vie se distribue par
      ses GitHub Releases, la question ne se pose pas.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      Android TV : app utilisable sans écran tactile, visible sur le launcher
      Leanback. `required="false"` sur leanback n'enlève rien à la TV (elle
      expose toujours la fonctionnalité) mais laisse l'app s'installer sur un
      téléphone, qui ne l'a pas. Sans ça, l'installation est purement et
      simplement refusée.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />


    <!--
      Visibilité des paquets (Android 11+, targetSdk 34) : sans cette
      déclaration, `queryIntentActivities` ne voit aucun moteur de
      reconnaissance vocale, et le bouton micro n'apparaîtrait sur aucun
      appareil — panne silencieuse.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".MooVieApp"
        android:allowBackup="true"
        android:banner="@mipmap/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MooVie">


        <!--
          Le lecteur du téléphone, dans sa propre fenêtre. Voir PlayerHost pour
          la raison : une Activity qui part en vignette laisse celle du dessous
          revenir au premier plan, ce qu'une application à Activity unique ne
          peut pas offrir.

          `exported="false"` : on n'y entre que depuis Moo-vie, jamais depuis un
          autre lanceur — elle n'a de sens qu'avec un flux déjà résolu.

          Les mêmes `configChanges` que MainActivity, et pour la même raison,
          plus impérative encore ici : sans `screenSize|smallestScreenSize|
          screenLayout`, chaque bascule en vignette recréerait l'Activity et
          redémarrerait la lecture.
        -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MooVie" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:theme="@style/Theme.MooVie.Splash">
            <!--
              Deux catégories, deux lanceurs : LEANBACK_LAUNCHER pour l'accueil
              Android TV, LAUNCHER pour le tiroir d'applications d'un téléphone.
              Sans la seconde, l'app s'installe sur téléphone mais son icône
              n'apparaît nulle part.

              `screenOrientation` a été retiré : il valait "landscape" et
              verrouillait le paysage. La TV est de toute façon en paysage.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Appairage de la télécommande : la page servie par le téléviseur
                 rebascule ici quand l'application est installée, en passant
                 l'adresse, le port et le jeton. Schéma privé plutôt que lien
                 web : rien de tout ceci n'existe sur Internet, et un App Link
                 exigerait un domaine à nous. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moovie" android:host="remote" />
            </intent-filter>
        </activity>
        <!-- Expose l'APK de mise à jour téléchargé à l'installateur système -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ui.remote.CastSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
