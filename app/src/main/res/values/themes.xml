<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème hôte pour l'Activity : le rendu réel est en Compose (MooVieTheme). -->
    <style name="Theme.MooVie" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Splash au lancement : fond violet branding + logo, puis bascule sur Theme.MooVie. -->
    <style name="Theme.MooVie.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MooVie</item>
    </style>
</resources>
